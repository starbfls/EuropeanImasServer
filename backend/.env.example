# 本地开发默认 local。执行 schema.sql 并配置下面两项后，改成 supabase。
STORAGE_BACKEND=local
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# 服务端 Secret key（sb_secret_...）。禁止放在 frontend/.env 或 VITE_ 变量中。
SUPABASE_SECRET_KEY=
# 老项目也支持 SUPABASE_SERVICE_ROLE_KEY，但优先使用上面的 Secret key。
SUPABASE_PENDING_BUCKET=imas-pending
SUPABASE_PUBLIC_BUCKET=imas-public

# 运行 python create_admin.py 生成账号、密码哈希及随机签名密钥。
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
SECRET_KEY=
FLASK_DEBUG=false
PORT=5000
# 仅在可信反向代理后、且已核对 X-Forwarded-For 写入方式时启用。
TRUST_PROXY=false
